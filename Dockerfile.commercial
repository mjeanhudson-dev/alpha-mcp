FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR /app

RUN groupadd --gid 10001 eloquent \
 && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin eloquent

COPY --chown=10001:10001 commercial_mcp_server.py ./

USER 10001:10001

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD python -c "import os, urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"PORT\",\"8080\")}/health', timeout=3)" || exit 1

CMD ["python", "-B", "commercial_mcp_server.py"]
